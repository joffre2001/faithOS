POSTGRES_DB=faithos
POSTGRES_USER=replace_with_database_user
POSTGRES_PASSWORD=replace_with_a_long_random_password
DB_URL=jdbc:postgresql://localhost:5433/faithos
DB_USERNAME=replace_with_database_user
DB_PASSWORD=replace_with_a_long_random_password
JWT_SECRET=replace_with_at_least_64_random_characters
